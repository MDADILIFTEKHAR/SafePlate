MAX_AGENT_ITERATIONS=3
MAX_SUBSTITUTION_ATTEMPTS=3
ENVIRONMENT=production
CORS_ORIGINS='["http://localhost:5173", "http://127.0.0.1:5173"]'
HOST=0.0.0.0
PORT=8000
