# SafePlate Environment Configuration
# Real-time, local-first food safety and meal planning

DEMO_MODE=false
MODEL_PROVIDER=ollama
MODEL_NAME=llama3.2:3b
OLLAMA_BASE_URL=http://localhost:11434
LLM_TIMEOUT_SECONDS=30
