# SafePlate Environment Configuration
# Local-first, privacy-respecting food safety and meal planning

# Demo Mode: Set to true to run deterministic AI simulation without Ollama
DEMO_MODE=true

# AI Provider Configuration
MODEL_PROVIDER=ollama
MODEL_NAME=llama3.2:3b
OLLAMA_BASE_URL=http://localhost:11434
LLM_TIMEOUT_SECONDS=30

# Database Configuration
DATABASE_URL=sqlite:///./safeplate.db

# Safety & Agent Loop Constraints
MAX_AGENT_ITERATIONS=3
MAX_SUBSTITUTION_ATTEMPTS=3

# Application Settings
ENVIRONMENT=development
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
HOST=0.0.0.0
PORT=8000
